{
  "name": "obsidian-blogger2",
  "version": "0.9.7",
  "description": "A plugin for publishing Obsidian notes to Blogger.",
  "keywords": [
    "blogger",
    "obsidian",
    "obsidian-blogger",
    "obsidian-plugin",
    "plugin"
  ],
  "license": "Apache-2.0",
  "author": "Hugo Sansaqua",
  "main": "main.js",
  "files": [
    "styles.css",
    "manifest.json",
    "main.js"
  ],
  "scripts": {
    "dev": "node --run build:esbuild -- watch",
    "pretest": "echo node --run test:typecheck",
    "test": "echo test",
    "test:typecheck": "tsc -noEmit -skipLibCheck",
    "test:local": "tsx test/toggle-post-status/test-restclient.ts",
    "prebuild": "node --run test:typecheck",
    "build": "node --run build:esbuild -- production",
    "build:esbuild": "node esbuild.config.mjs",
    "npm:publish:bump": "node --run version:bump && npm publish",
    "preversion": "echo preversion && pnpm run build",
    "version": "node version-bump.mjs",
    "version:bump": "ynpx yarn-tool version",
    "prepublishOnly": "pnpm run preversion",
    "postpublish": "node --run postpublish:changelog && node --run postpublish:git:commit && node --run postpublish:git:tag && node --run postpublish:git:push",
    "postpublish:changelog": "ynpx --quiet @yarn-tool/changelog && git add ./CHANGELOG.md",
    "postpublish:git:commit": "git add manifest.json versions.json & git commit -m \"chore(release): publish\" . & echo postpublish:git:commit",
    "postpublish:git:push": "git push --follow-tags",
    "postpublish:git:tag": "ynpx --quiet @yarn-tool/tag",
    "ncu": "yarn-tool ncu -u",
    "sort-package-json": "yarn-tool sort"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.8.0",
    "builtin-modules": "^5.2.0",
    "date-fns": "^4.1.0",
    "esbuild": "0.28.0",
    "file-type-checker": "^1.1.6",
    "juice": "^11.1.1",
    "lodash-es": "^4.18.1",
    "markdown-it": "^14.1.1",
    "markdown-it-footnote": "^4.0.0",
    "mathjax-full": "^3.2.2",
    "obsidian": "latest",
    "tslib": "2.8.1",
    "ts-type": "^3.0.13",
    "typescript": "^6.0.3"
  }
}
