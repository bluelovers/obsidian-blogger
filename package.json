{
  "name": "obsidian-blogger",
  "version": "0.9.7",
  "description": "A plugin for publishing Obsidian notes to Blogger.",
  "main": "main.js",
  "scripts": {
    "dev": "node --run build:esbuild -- watch",
    "prebuild": "node --run test:typecheck",
    "build": "node --run build:esbuild -- production",
    "build:esbuild": "node esbuild.config.mjs",
    "test:typecheck": "tsc -noEmit -skipLibCheck",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "blogger",
    "obsidian",
    "plugin"
  ],
  "files": [
    "styles.css",
    "manifest.json",
    "main.js"
  ],
  "author": "Hugo Sansaqua",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.8.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "builtin-modules": "^5.2.0",
    "date-fns": "^4.1.0",
    "esbuild": "0.28.0",
    "eslint-plugin-node": "^11.1.0",
    "file-type-checker": "^1.1.6",
    "juice": "^11.1.1",
    "lodash-es": "^4.18.1",
    "markdown-it": "^14.1.1",
    "markdown-it-footnote": "^4.0.0",
    "mathjax-full": "^3.2.2",
    "obsidian": "latest",
    "tslib": "2.8.1",
    "typescript": "^6.0.3"
  }
}
