exports[`MD → HTML Conversion > Basic Inline Elements > should match snapshot 1`] = `
{
  "groupName": "Basic Inline Elements",
  "results": [
    {
      "input": "Hello world",
      "name": "plain paragraph",
      "output": "<p>Hello world</p>
",
    },
    {
      "input": "This is **bold** text",
      "name": "bold text",
      "output": "<p>This is <strong>bold</strong> text</p>
",
    },
    {
      "input": "This is *italic* text",
      "name": "italic text",
      "output": "<p>This is <em>italic</em> text</p>
",
    },
    {
      "input": "***bold italic*** and **bold *italic***",
      "name": "bold and italic combined",
      "output": "<p><em><strong>bold italic</strong></em> and <strong>bold <em>italic</em></strong></p>
",
    },
    {
      "input": "Use the \`console.log()\` function",
      "name": "inline code",
      "output": "<p>Use the <code>console.log()</code> function</p>
",
    },
    {
      "input": "This is ~~deleted~~ text",
      "name": "strikethrough",
      "output": "<p>This is <s>deleted</s> text</p>
",
    },
  ],
}
`;

exports[`MD → HTML Conversion > Block Elements > should match snapshot 1`] = `
{
  "groupName": "Block Elements",
  "results": [
    {
      "input": "> This is a blockquote",
      "name": "blockquote",
      "output": "<blockquote>
<p>This is a blockquote</p>
</blockquote>
",
    },
    {
      "input": "> First paragraph
>
> Second paragraph",
      "name": "blockquote with multiple paragraphs",
      "output": "<blockquote>
<p>First paragraph</p>
<p>Second paragraph</p>
</blockquote>
",
    },
    {
      "input": "\`\`\`
const x = 1;
console.log(x);
\`\`\`",
      "name": "fenced code block",
      "output": "<pre><code>const x = 1;
console.log(x);
</code></pre>
",
    },
    {
      "input": "\`\`\`javascript
const x = 1;
console.log(x);
\`\`\`",
      "name": "fenced code block with language",
      "output": "<pre><code class="language-javascript">const x = 1;
console.log(x);
</code></pre>
",
    },
    {
      "input": "---",
      "name": "horizontal rule",
      "output": "<hr>
",
    },
  ],
}
`;

